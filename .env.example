# Floor Plan to Video — environment template
# Copy to .env (never commit .env). Secrets stay server-side only; frontend
# receives only NEXT_PUBLIC_* values.

# ------- shared (server + workers) -------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
UPSTASH_REDIS_URL=

# ------- frontend (public) -------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=

# ------- providers -------
# ANTHROPIC_MODEL: e.g. claude-opus-4-7 or claude-sonnet-4-6
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# OPENAI_IMAGE_MODEL: e.g. gpt-image-1
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=

TOGETHER_API_KEY=
TOGETHER_VIDEO_MODEL=ByteDance/Seedance-2.5

RUNPOD_API_KEY=
RUNPOD_GPU_POD_ID=                # id of the RTX 4090 pod (Blender + edit)
RUNPOD_CPU_POD_ID=                # id of the always-on CPU pod (API + extract/image/video workers)

# ------- guardrails -------
DEFAULT_PROJECT_BUDGET_USD=40
POD_IDLE_SHUTDOWN_MINUTES=15

# ------- pipeline mode (decided by M0 spike) -------
# Together's Seedance 2.5 API forbids combining frame_images with reference_videos
# in a single request (per docs.together.ai/docs/seedance2.5-quickstart as of 2026-10-27).
# Therefore the pipeline runs in frames_only mode: pass first+last frames, describe the
# camera move in words. The "reference_guided" mode (reference_videos + reference_images,
# no first/last) is also available if we ever want to try driving-video style transfer
# at the cost of exact camera-path fidelity.
VIDEO_MODE=frames_only

# ------- storage bucket names -------
SUPABASE_BUCKET_UPLOADS=uploads
SUPABASE_BUCKET_RENDERS=renders
SUPABASE_BUCKET_FRAMES=frames
SUPABASE_BUCKET_TAKES=takes
SUPABASE_BUCKET_EXPORTS=exports
