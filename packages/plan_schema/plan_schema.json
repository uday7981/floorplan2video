{
  "$defs": {
    "Defaults": {
      "additionalProperties": false,
      "properties": {
        "floor_thickness": {
          "description": "Floor slab thickness in metres.",
          "exclusiveMinimum": 0,
          "title": "Floor Thickness",
          "type": "number"
        }
      },
      "required": [
        "floor_thickness"
      ],
      "title": "Defaults",
      "type": "object"
    },
    "Level": {
      "additionalProperties": false,
      "description": "One storey of the building. Walls/openings/rooms/voids are nested so\nIDs stay scoped per level and the Blender builder iterates storeys\ndirectly.",
      "properties": {
        "id": {
          "description": "Stable id, e.g. 'ground', 'first'.",
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "name": {
          "description": "Human label, e.g. 'Ground Floor'.",
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "index": {
          "description": "0 = ground. Higher = higher up.",
          "minimum": 0,
          "title": "Index",
          "type": "integer"
        },
        "elevation": {
          "description": "Metres from world origin to this level's slab top.",
          "minimum": 0,
          "title": "Elevation",
          "type": "number"
        },
        "floor_to_floor_height": {
          "default": 3.0,
          "description": "Height from this level's slab top to the next level's slab top (metres).",
          "exclusiveMinimum": 0,
          "title": "Floor To Floor Height",
          "type": "number"
        },
        "walls": {
          "items": {
            "$ref": "#/$defs/Wall"
          },
          "minItems": 1,
          "title": "Walls",
          "type": "array"
        },
        "openings": {
          "items": {
            "$ref": "#/$defs/Opening"
          },
          "title": "Openings",
          "type": "array"
        },
        "rooms": {
          "items": {
            "$ref": "#/$defs/Room"
          },
          "minItems": 1,
          "title": "Rooms",
          "type": "array"
        },
        "voids": {
          "items": {
            "$ref": "#/$defs/Void"
          },
          "title": "Voids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "index",
        "elevation",
        "walls",
        "rooms"
      ],
      "title": "Level",
      "type": "object"
    },
    "Meta": {
      "additionalProperties": false,
      "properties": {
        "scale_source": {
          "$ref": "#/$defs/ScaleSource"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "scale_source",
        "confidence"
      ],
      "title": "Meta",
      "type": "object"
    },
    "Opening": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "wall_id": {
          "minLength": 1,
          "title": "Wall Id",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/OpeningType"
        },
        "offset": {
          "minimum": 0,
          "title": "Offset",
          "type": "number"
        },
        "width": {
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "number"
        },
        "height": {
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "number"
        },
        "sill": {
          "minimum": 0,
          "title": "Sill",
          "type": "number"
        },
        "main_entrance": {
          "default": false,
          "title": "Main Entrance",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "wall_id",
        "type",
        "offset",
        "width",
        "height",
        "sill"
      ],
      "title": "Opening",
      "type": "object"
    },
    "OpeningType": {
      "enum": [
        "door",
        "window",
        "opening"
      ],
      "title": "OpeningType",
      "type": "string"
    },
    "Room": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/RoomType"
        },
        "polygon": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "minItems": 3,
          "title": "Polygon",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "type",
        "polygon"
      ],
      "title": "Room",
      "type": "object"
    },
    "RoomType": {
      "description": "Common room types the extractor + image prompt both understand.\n\nFuture-proofing: `other` is the catch-all for anything not listed. The\nimage prompt uses `room.name` (free text) as the primary descriptor \u2014\nso a well-named room produces a correct image even when the type here\nis `other`. Expand this enum as architectural vocabularies grow.",
      "enum": [
        "living",
        "dining",
        "kitchen",
        "bedroom",
        "bath",
        "hall",
        "corridor",
        "stair",
        "utility",
        "laundry",
        "pantry",
        "closet",
        "storage",
        "office",
        "library",
        "garage",
        "gym",
        "media",
        "terrace",
        "balcony",
        "porch",
        "other"
      ],
      "title": "RoomType",
      "type": "string"
    },
    "ScaleSource": {
      "enum": [
        "dimension_text",
        "scale_bar",
        "user_input"
      ],
      "title": "ScaleSource",
      "type": "string"
    },
    "Stair": {
      "additionalProperties": false,
      "description": "A vertical connection between two levels.\n\nfootprint   \u2014 polygon on plan view (xy) that the stair occupies.\nstart_point \u2014 xy where the user begins the climb at from_level elevation.\nend_point   \u2014 xy where the user emerges at to_level elevation.\ndirection   \u2014 'up' or 'down' when traveling from_level \u2192 to_level.\n              Normally 'up'; 'down' is allowed for descending stairs\n              (e.g. a basement).",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "from_level": {
          "minLength": 1,
          "title": "From Level",
          "type": "string"
        },
        "to_level": {
          "minLength": 1,
          "title": "To Level",
          "type": "string"
        },
        "footprint": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "minItems": 3,
          "title": "Footprint",
          "type": "array"
        },
        "start_point": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Start Point",
          "type": "array"
        },
        "end_point": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "End Point",
          "type": "array"
        },
        "direction": {
          "$ref": "#/$defs/StairDirection",
          "default": "up"
        }
      },
      "required": [
        "id",
        "from_level",
        "to_level",
        "footprint",
        "start_point",
        "end_point"
      ],
      "title": "Stair",
      "type": "object"
    },
    "StairDirection": {
      "description": "Travel direction when going from_level \u2192 to_level. Normally 'up'.",
      "enum": [
        "up",
        "down"
      ],
      "title": "StairDirection",
      "type": "string"
    },
    "Void": {
      "additionalProperties": false,
      "description": "A polygon on this level's slab that is cut away \u2014 stair wells + any\ndouble-height spaces. Blender boolean-DIFFs the polygon from the slab\nABOVE this level so the camera can see through.",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "polygon": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "minItems": 3,
          "title": "Polygon",
          "type": "array"
        }
      },
      "required": [
        "id",
        "polygon"
      ],
      "title": "Void",
      "type": "object"
    },
    "Wall": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "a": {
          "description": "Centreline start point (x, y) in metres.",
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "A",
          "type": "array"
        },
        "b": {
          "description": "Centreline end point (x, y) in metres.",
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "B",
          "type": "array"
        },
        "thickness": {
          "maximum": 0.6,
          "minimum": 0.05,
          "title": "Thickness",
          "type": "number"
        },
        "height": {
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "number"
        },
        "exterior": {
          "default": false,
          "title": "Exterior",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "a",
        "b",
        "thickness",
        "height"
      ],
      "title": "Wall",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "units": {
      "default": "m",
      "pattern": "^m$",
      "title": "Units",
      "type": "string"
    },
    "meta": {
      "$ref": "#/$defs/Meta"
    },
    "defaults": {
      "$ref": "#/$defs/Defaults"
    },
    "levels": {
      "items": {
        "$ref": "#/$defs/Level"
      },
      "maxItems": 6,
      "minItems": 1,
      "title": "Levels",
      "type": "array"
    },
    "stairs": {
      "items": {
        "$ref": "#/$defs/Stair"
      },
      "title": "Stairs",
      "type": "array"
    }
  },
  "required": [
    "meta",
    "defaults",
    "levels"
  ],
  "title": "Plan",
  "type": "object"
}
